# PostgreSQL connection string. On Railway, reference the Postgres service:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
DATABASE_URL="postgresql://ccna:ccna@localhost:5432/ccna?schema=public"

# Allow new accounts to register. Registration is ALWAYS allowed while the
# database has zero users (so you can create the first account). Set to "true"
# to let additional people sign up.
ALLOW_REGISTRATION="false"

# Optional: seed script creates this user (with demo data) if it doesn't exist.
SEED_USER_EMAIL=""
SEED_USER_PASSWORD=""

# Media/image storage. "local" (default) writes to STORAGE_DIR — on Railway,
# attach a Volume and point STORAGE_DIR at it (e.g. /data/media).
# "s3" uses any S3-compatible bucket (Railway Buckets, Cloudflare R2, AWS S3...).
STORAGE_DRIVER="local"
STORAGE_DIR="./storage"
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"
